{
  "name": "seveinn.github.io",
  "version": "1.0.0",
  "description": "Seveinn个人作品展示网站",
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-blog-index.mjs --include-drafts",
    "dev": "vite --mode development",
    "prebuild": "node scripts/build-blog-index.mjs",
    "build": "tsc && vite build --mode production",
    "build:blog": "node scripts/build-blog-index.mjs",
    "preview": "vite preview --mode production",
    "start": "vite preview --mode production",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "lil-gui": "^0.21.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.20.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "gray-matter": "^4.0.3",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
}
